---
import { formatDuration, type Video } from "../content/videos";
interface Props {
  video: Video;
  compact?: boolean;
}
const { video: v, compact = false } = Astro.props;
const label = v.title ?? `Video ${v.number}`;
const credits = [
  v.client,
  v.kind === "practice" ? "Practice edit" : undefined,
  v.role,
  v.year,
].filter(Boolean);
const duration = formatDuration(v.durationSec);
---

<button
  type="button"
  class:list={["card", { "card--compact": compact }]}
  data-video-open
  data-full={v.full}
  data-poster={v.poster}
  data-title={label}
  aria-label={`Play ${label} with sound controls`}
>
  <span class="card__frame">
    <video
      class="card__preview"
      muted
      playsinline
      loop
      preload="none"
      poster={v.poster}
      data-src={v.preview}
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
    ></video>
    <span class="card__play" aria-hidden="true"></span>
  </span>
  {!compact && (
    <span class="card__meta">
      <span class="label card__no">{v.number}</span>
      {v.title && <span class="card__title">{v.title}</span>}
      {credits.length > 0 && <span class="label">{credits.join(" · ")}</span>}
      {duration && <span class="label card__dur">{duration}</span>}
    </span>
  )}
</button>

<style>
  .card {
    display: grid;
    gap: 14px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .card__frame {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--graphite);
  }
  .card__preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.85) sepia(0.2) hue-rotate(120deg) brightness(0.8);
    transition: filter 0.4s var(--ease-cut);
  }
  .card:global(.is-playing) .card__preview,
  .card:hover .card__preview,
  .card:focus-visible .card__preview {
    filter: none;
  }
  .card__play {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(230 236 233 / 0.6);
    border-radius: 50%;
    background: rgb(8 17 15 / 0.6);
  }
  .card__play::after {
    content: "";
    position: absolute;
    left: 15px;
    top: 12px;
    border-left: 13px solid var(--mist);
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }
  .card:hover .card__frame,
  .card:focus-visible .card__frame {
    border-color: var(--crimson);
  }
  .card__meta {
    display: grid;
    gap: 4px;
  }
  .card__no {
    color: var(--crimson);
  }
  .card__title {
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .card--compact .card__play {
    width: 32px;
    height: 32px;
    right: 8px;
    bottom: 8px;
  }
  .card--compact .card__play::after {
    left: 12px;
    top: 9px;
    border-left-width: 10px;
    border-top-width: 6px;
    border-bottom-width: 6px;
  }
</style>
