---
import SectionHead from "./SectionHead.astro";
import { profile } from "../content/profile";
interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section class="section" aria-labelledby="about">
  <div class="wrap">
    <SectionHead number={number} title="About" id="about" />
    <div class="about">
      <p class="label about__role" data-fade>
        {profile.name} · {profile.role}
      </p>
      <p class="about__summary" data-fade style="--i:1">
        {profile.summary}
      </p>
      <ul class="about__langs" data-fade style="--i:2" aria-label="Languages">
        {profile.languages.map((l) => (
          <li>
            <span class="about__lang">{l.name}</span>
            <span class="label">{l.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .about__role {
    grid-column: 1 / span 3;
    margin: 0.6em 0 0;
  }
  .about__summary {
    grid-column: 4 / span 8;
    margin: 0;
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.4rem);
    line-height: 1.3;
    font-weight: 400;
    max-width: 30ch;
  }
  .about__langs {
    grid-column: 4 / span 8;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 40px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .about__langs li {
    display: grid;
    gap: 4px;
  }
  .about__lang {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .about__role,
    .about__summary,
    .about__langs {
      grid-column: 1 / -1;
    }
  }
</style>
