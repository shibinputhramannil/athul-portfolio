---
import SectionHead from "./SectionHead.astro";
import { profile } from "../content/profile";
interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section class="section" aria-labelledby="experience">
  <div class="wrap">
    <SectionHead number={number} title="Experience" id="experience" />

    <ol class="edl">
      {profile.experience.map((job, i) => (
        <li class="edl__row" data-fade style={`--i:${i}`}>
          <span class="label edl__no">{String(i + 1).padStart(3, "0")}</span>
          <span class="label edl__period">{job.period}</span>
          <div class="edl__body">
            <h3 class="edl__company">{job.company}</h3>
            <p class="label edl__role">{job.role}</p>
            <p class="edl__desc">{job.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="facts">
      <div class="facts__block facts__skills" data-fade>
        <h3 class="label">Skills</h3>
        <ul>
          {profile.skills.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
      <div class="facts__block" data-fade style="--i:1">
        <h3 class="label">Tools</h3>
        <ul class="facts__tools">
          {profile.tools.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
      <div class="facts__block" data-fade style="--i:2">
        <h3 class="label">Education</h3>
        <ul class="facts__edu">
          {profile.education.map((e) => (
            <li>
              <span class="facts__q">{e.qualification}</span>
              <span>{e.institution}</span>
              <span class="label">{e.period}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .edl {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .edl__row {
    display: grid;
    grid-template-columns: 64px 140px minmax(0, 1fr);
    gap: var(--gutter);
    padding: clamp(24px, 3vw, 40px) 0;
    border-bottom: 1px solid var(--line);
  }
  .edl__no {
    color: var(--crimson);
  }
  .edl__period {
    color: var(--mist);
  }
  .edl__company {
    margin: 0;
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .edl__role {
    margin: 10px 0 14px;
    color: var(--seafoam);
  }
  .edl__desc {
    margin: 0;
    max-width: 60ch;
    color: rgb(230 236 233 / 0.82);
  }
  .facts {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: clamp(32px, 4vw, 64px) var(--gutter);
    margin-top: clamp(48px, 6vw, 96px);
  }
  .facts h3 {
    margin: 0 0 16px;
  }
  .facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts__skills ul {
    columns: 2;
    column-gap: var(--gutter);
  }
  .facts__skills li {
    break-inside: avoid;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .facts__tools li {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--seafoam);
    padding: 6px 0;
  }
  .facts__edu li {
    display: grid;
    gap: 2px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .facts__q {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .edl__row {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .edl__period {
      grid-column: 2;
      grid-row: 1;
    }
    .edl__body {
      grid-column: 1 / -1;
    }
    .facts {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .facts__skills ul {
      columns: 1;
    }
  }
</style>
