---
import Icon from "./Icon.astro";
import { profile } from "../content/profile";
import type { IconName } from "../lib/icons";
interface Props {
  nav: { id: string; label: string; icon: IconName }[];
}
const { nav } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="label site-header__name" href="#top">
      <span class="site-header__rec" aria-hidden="true"></span>
      {profile.name}
    </a>
    <span class="label site-header__tc" aria-hidden="true" data-scroll-tc>
      TC 00:00:00:00
    </span>
    <nav class="site-nav" aria-label="Sections">
      <ul>
        {nav.map((item) => (
          <li>
            <a class="label" href={`#${item.id}`} data-nav={item.id}>
              <Icon name={item.icon} size={16} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<nav class="tabbar" aria-label="Sections">
  <ul style={`--n:${nav.length}`}>
    {nav.map((item) => (
      <li>
        <a href={`#${item.id}`} data-nav={item.id}>
          <Icon name={item.icon} size={20} />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgb(8 17 15 / 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
  }
  .site-header a {
    color: var(--mist);
    text-decoration: none;
  }
  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }
  .site-header__rec {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--crimson);
    box-shadow: 0 0 10px rgb(234 58 50 / 0.7);
  }
  .site-header__tc {
    margin-right: auto;
    padding-left: 24px;
    border-left: 1px solid var(--line);
    color: var(--seafoam);
    font-variant-numeric: tabular-nums;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(8px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 4px;
    letter-spacing: 0.14em;
    transition: color 0.2s;
  }
  .site-nav a::after {
    content: "";
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 0;
    height: 2px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-cut);
  }
  .site-nav a:hover,
  .site-nav a[aria-current="true"] {
    color: var(--seafoam);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current="true"]::after {
    transform: scaleX(1);
  }

  .tabbar {
    display: none;
  }

  @media (max-width: 1100px) {
    .site-header__tc {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .site-nav {
      display: none;
    }
    .tabbar {
      display: block;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      padding-bottom: env(safe-area-inset-bottom);
      background: rgb(8 17 15 / 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
    }
    .tabbar ul {
      display: grid;
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .tabbar a {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 4px;
      min-height: var(--tabbar-h);
      padding: 10px 2px 8px;
      color: var(--fog);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .tabbar a[aria-current="true"] {
      color: var(--seafoam);
    }
    .tabbar a[aria-current="true"]::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 30%;
      right: 30%;
      height: 2px;
      background: var(--crimson);
    }
  }
</style>
