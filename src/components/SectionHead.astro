---
interface Props {
  number: string;
  title: string;
  id: string;
}
const { number, title, id } = Astro.props;
---

<header class="sh" data-reveal>
  <div class="label sh__meta" aria-hidden="true">
    <span class="sh__num">({number})</span>
    <span class="sh__tc">TC 00:{number}:00:00</span>
    <svg
      class="sh__ast"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    >
      <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"></path>
    </svg>
  </div>
  <h2 class="sh__title" id={id}>
    <span class="rl">
      <span>
        <span data-stretch>{title}</span>
      </span>
    </span>
    <span class="sh__cut" aria-hidden="true"></span>
  </h2>
  <div class="sh__rule" aria-hidden="true">
    <span class="sh__head"></span>
  </div>
</header>

<style>
  .sh {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .sh__meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sh__num {
    color: var(--crimson);
  }
  .sh__tc {
    color: var(--seafoam);
    font-variant-numeric: tabular-nums;
  }
  .sh__ast {
    margin-left: auto;
    color: var(--crimson);
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .sh__title {
    position: relative;
    margin: 0;
    overflow-x: clip;
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .sh__cut {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--crimson);
    transform: scaleX(0);
    pointer-events: none;
  }
  :global(.js) .sh:global(.is-in) .sh__cut {
    animation: cut 0.36s var(--ease-cut);
  }
  @keyframes cut {
    0% {
      transform-origin: left;
      transform: scaleX(0);
    }
    50% {
      transform-origin: left;
      transform: scaleX(1);
    }
    50.1% {
      transform-origin: right;
    }
    100% {
      transform-origin: right;
      transform: scaleX(0);
    }
  }
  .sh__rule {
    position: relative;
    height: 9px;
    margin-top: clamp(10px, 2vw, 24px);
    background:
      linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat,
      repeating-linear-gradient(
          90deg,
          rgb(135 149 146 / 0.5) 0 1px,
          transparent 1px 48px
        )
        left bottom / 100% 6px no-repeat;
    transform-origin: left;
  }
  .sh__head {
    position: absolute;
    left: 100%;
    bottom: -4px;
    width: 9px;
    height: 9px;
    translate: -50% 0;
    background: var(--crimson);
    box-shadow: 0 0 12px rgb(234 58 50 / 0.7);
  }
  :global(.js) .sh .sh__rule {
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-cut) 0.15s;
  }
  :global(.js) .sh:global(.is-in) .sh__rule {
    transform: none;
  }
  :global(.js) .sh .sh__head {
    left: 0;
    transition: left 1.1s var(--ease-cut) 0.15s;
  }
  :global(.js) .sh:global(.is-in) .sh__head {
    left: 100%;
  }
</style>
