---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { softwareDemos, watchUrl, embedUrl } from "../content/software";
interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section class="section" aria-labelledby="software">
  <div class="wrap">
    <SectionHead number={number} title="Software in Action" id="software" />
    <p class="soft__intro" data-fade>
      Official demos of the software I edit with, published by Adobe and
      Blackmagic Design. They are not my edits: each plays in YouTube's player
      and is credited to its source.
    </p>
    <ol class="chapters">
      {softwareDemos.map((d, i) => (
        <li class="chapter" data-reveal aria-labelledby={`soft-${d.brand}`}>
          <div class="chapter__rail label" aria-hidden="true">
            <span class="chapter__num">{String(i + 1).padStart(2, "0")}</span>
            <span>/ {String(softwareDemos.length).padStart(2, "0")}</span>
            <span class="chapter__line" />
          </div>
          <div class="chapter__body">
            <div class="chapter__text">
              <h3 class="chapter__tool" id={`soft-${d.brand}`}>
                <Icon brand={d.brand} size={24} />
                {d.tool}
              </h3>
              <p class="label chapter__kind">Official demo</p>
              <p class="chapter__title">{d.title}</p>
              <p class="label chapter__credit">
                Source:{" "}
                <a href={d.channelUrl} rel="noopener" target="_blank">
                  {d.channel}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>{" "}
                on YouTube
              </p>
              <a
                class="chapter__link label"
                href={watchUrl(d.youtubeId)}
                rel="noopener"
                target="_blank"
              >
                Watch on YouTube
                <Icon name="arrow-right" size={14} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
            <div
              class="soft__frame"
              data-embed={embedUrl(d.youtubeId)}
              data-embed-title={`${d.title}, ${d.channel}`}
            >
              <button
                type="button"
                class="soft__play"
                aria-label={`Play ${d.title}, by ${d.channel}. Loads the YouTube player.`}
              >
                <span class="soft__marks" aria-hidden="true" />
                <span class="soft__mark" aria-hidden="true">
                  <Icon brand={d.brand} size={48} />
                </span>
                <span class="pill soft__cta" aria-hidden="true">
                  <Icon name="play" size={16} />
                  Play demo
                </span>
                <span class="label soft__note" aria-hidden="true">
                  Loads YouTube player
                </span>
              </button>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Click-to-play: the YouTube iframe only loads after a click, one demo at a time.
  let active: { frame: HTMLElement; button: HTMLButtonElement } | null = null;

  document
    .querySelectorAll<HTMLElement>(".soft__frame[data-embed]")
    .forEach((frame) => {
      const button = frame.querySelector<HTMLButtonElement>(".soft__play");
      button?.addEventListener("click", () => {
        if (active) {
          active.frame.replaceChildren(active.button);
          active.frame.classList.remove("is-live");
        }
        const iframe = document.createElement("iframe");
        iframe.src = frame.dataset.embed!;
        iframe.title = frame.dataset.embedTitle ?? "YouTube video";
        iframe.allow =
          "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        frame.replaceChildren(iframe);
        frame.classList.add("is-live");
        iframe.focus();
        active = { frame, button };
      });
    });
</script>

<style>
  .soft__intro {
    max-width: 58ch;
    margin: 0 0 clamp(16px, 3vw, 32px);
    color: var(--fog);
  }
  .chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapter {
    padding-block: clamp(48px, 9vh, 112px);
  }
  .chapter__rail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 48px);
    font-variant-numeric: tabular-nums;
  }
  .chapter__num {
    color: var(--crimson);
  }
  .chapter__line {
    flex: 1;
    height: 1px;
    margin-left: 14px;
    background: linear-gradient(
      90deg,
      var(--crimson) 0 48px,
      rgb(230 236 233 / 0.14) 48px
    );
    transform-origin: left;
  }
  .chapter__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }
  .chapter__text {
    grid-column: 1 / span 4;
    display: grid;
    gap: 12px;
    justify-items: start;
    max-width: 38ch;
  }
  .soft__frame {
    position: relative;
    grid-column: 5 / span 8;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgb(230 236 233 / 0.12);
    background:
      radial-gradient(
        120% 90% at 15% 0%,
        rgb(18 58 51 / 0.85),
        transparent 60%
      ),
      radial-gradient(
        70% 60% at 100% 100%,
        rgb(234 58 50 / 0.12),
        transparent 60%
      ),
      var(--graphite);
  }
  .chapter__tool {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .chapter__kind {
    margin: 0;
    color: var(--seafoam);
  }
  .chapter__title {
    margin: 4px 0 0;
    color: var(--mist);
  }
  .chapter__credit {
    margin: 0;
  }
  .chapter__credit a,
  .chapter__link {
    color: var(--seafoam);
  }
  .chapter__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .soft__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .soft__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--mist);
    font: inherit;
    cursor: pointer;
  }
  .soft__play:focus-visible {
    outline: 2px solid var(--seafoam);
    outline-offset: -4px;
  }
  .soft__marks {
    position: absolute;
    inset: 14px;
    pointer-events: none;
    background:
      linear-gradient(var(--seafoam), var(--seafoam)) top left / 18px 1px,
      linear-gradient(var(--seafoam), var(--seafoam)) top left / 1px 18px,
      linear-gradient(var(--seafoam), var(--seafoam)) bottom right / 18px 1px,
      linear-gradient(var(--seafoam), var(--seafoam)) bottom right / 1px 18px;
    background-repeat: no-repeat;
    opacity: 0.7;
  }
  .soft__mark {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border: 1px solid rgb(230 236 233 / 0.14);
    background: rgb(8 17 15 / 0.55);
  }
  .soft__cta {
    pointer-events: none;
  }
  .soft__note {
    font-size: 11px;
  }
  /* Motion between chapters: rail draws in, text and frame rise, one light sweep. */
  :global(.js) .chapter__line {
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-cut);
  }
  :global(.js) .chapter__text,
  :global(.js) .soft__frame {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s var(--ease-cut),
      transform 0.8s var(--ease-cut);
  }
  :global(.js) .soft__frame {
    transition-delay: 0.12s;
  }
  :global(.js) .chapter.is-in .chapter__line {
    transform: scaleX(1);
  }
  :global(.js) .chapter.is-in .chapter__text,
  :global(.js) .chapter.is-in .soft__frame {
    opacity: 1;
    transform: none;
  }
  .soft__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent 35%,
      rgb(142 210 190 / 0.14) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
  }
  :global(.js) .chapter.is-in .soft__frame::after {
    animation: soft-sweep 1.4s var(--ease-cut) 0.5s both;
  }
  .soft__frame.is-live::after {
    display: none;
  }
  @keyframes soft-sweep {
    to {
      transform: translateX(100%);
    }
  }
  :global(html:not(.js)) .soft__cta,
  :global(html:not(.js)) .soft__note {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .chapter__line,
    :global(.js) .chapter__text,
    :global(.js) .soft__frame {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .soft__frame::after {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .chapter__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .chapter__text,
    .soft__frame {
      grid-column: 1;
    }
    .soft__mark {
      width: 68px;
      height: 68px;
    }
  }
</style>
