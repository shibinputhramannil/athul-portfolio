---
import SectionHead from "./SectionHead.astro";
import VideoCard from "./VideoCard.astro";
import Icon from "./Icon.astro";
import type { Video } from "../content/videos";

interface Props {
  number: string;
  videos: Video[];
}
const { number, videos } = Astro.props;
// Every edit is shown at once; the strip is kept for very long lists.
const asStrip = videos.length > 24;
const count = String(videos.length).padStart(2, "0");
---

<section class="section" aria-labelledby="work">
  <div class="wrap">
    <SectionHead number={number} title="Selected work" id="work" />
    <div class="work__bar">
      <p class="label work__hint">
        <span>
          <Icon name="volume-off" size={16} />
          Previews play muted while on screen.
        </span>
        <span>
          <Icon name="play" size={16} />
          Tap or press Enter to play with sound.
        </span>
      </p>
      <p class="label work__count">
        <span class="work__now" aria-hidden="true">
          <span class="work__rec"></span>
          Now <span data-playlist-now>{videos[0]?.number}</span>
        </span>
        <span>/ {count}</span>
        <span class="sr-only">edits</span>
      </p>
      {asStrip && (
        <div class="work__nav">
          <button
            class="work__btn label"
            type="button"
            data-strip-prev
            aria-label="Previous videos"
          >
            <Icon name="arrow-left" size={16} />
            Prev
          </button>
          <button
            class="work__btn label"
            type="button"
            data-strip-next
            aria-label="Next videos"
          >
            Next
            <Icon name="arrow-right" size={16} />
          </button>
        </div>
      )}
    </div>
    {!asStrip && (
      <ul class="work-grid">
        {videos.map((v, i) => (
          <li
            class="work-grid__item"
            data-fade
            data-number={v.number}
            style={`--i:${i}`}
          >
            <VideoCard video={v} />
          </li>
        ))}
      </ul>
    )}
  </div>
  {asStrip && (
    <ul
      class="strip"
      data-strip
      tabindex="0"
      role="region"
      aria-label="Selected work, scroll sideways"
    >
      {videos.map((v) => (
        <li class="strip__item" data-fade data-number={v.number}>
          <VideoCard video={v} />
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .work__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .work__bar p {
    margin: 0;
  }
  .work__hint {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .work__hint span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .work__count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fog);
    font-variant-numeric: tabular-nums;
  }
  .work__now {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--seafoam);
  }
  .work__rec {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--crimson);
    box-shadow: 0 0 8px rgb(234 58 50 / 0.8);
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(16px, 2.5vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-grid__item:nth-child(even) {
    margin-top: clamp(24px, 5vw, 80px);
  }
  @media (max-width: 1100px) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }
    .work-grid__item:nth-child(even) {
      margin-top: 36px;
    }
  }
  .work__nav {
    display: flex;
    gap: 8px;
  }
  .work__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(230 236 233 / 0.35);
    border-radius: 999px;
    background: none;
    color: var(--mist);
    cursor: pointer;
  }
  .work__btn:hover {
    border-color: var(--crimson);
    color: var(--crimson);
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(220px, 22vw, 340px);
    gap: var(--gutter);
    margin: 0;
    padding: 0 var(--margin) 16px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--margin);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--deep-teal) transparent;
  }
  .strip__item {
    scroll-snap-align: start;
  }
  @media (max-width: 600px) {
    .strip {
      grid-auto-columns: 72vw;
    }
  }
</style>
