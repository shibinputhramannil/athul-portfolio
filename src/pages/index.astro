---
import Base from "../layouts/Base.astro";
import Playhead from "../components/Playhead.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Showreel from "../components/Showreel.astro";
import SelectedWork from "../components/SelectedWork.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import SoftwareInAction from "../components/SoftwareInAction.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Player from "../components/Player.astro";
import { profile } from "../content/profile";
import { getShowreel, getVisibleVideos } from "../content/videos";
import type { IconName } from "../lib/icons";

const videos = getVisibleVideos();
const showreel = getShowreel(videos);

const showWork = videos.length > 0;

const sections = [
  showreel && { id: "reel", label: "Reel", icon: "play" },
  showWork && { id: "work", label: "Work", icon: "work" },
  { id: "about", label: "About", icon: "about" },
  { id: "experience", label: "Experience", icon: "experience" },
  { id: "contact", label: "Contact", icon: "contact" },
].filter(Boolean) as { id: string; label: string; icon: IconName }[];

// "Software in Action" is numbered in page order but left out of the nav bars.
const order = sections.flatMap((s) =>
  s.id === "contact" ? ["software", s.id] : [s.id],
);
const numberOf = (id: string) => String(order.indexOf(id) + 1).padStart(2, "0");
---

<Base title={`${profile.name} | ${profile.role}`} description={profile.summary}>
  <Playhead />
  <Header nav={sections} />
  <main id="main">
    <Hero videos={videos} hasWork={videos.length > 0} workHref="#work" />
    {showreel && (
      <Showreel number={numberOf("reel")} videos={videos} showreel={showreel} />
    )}
    {showWork && <SelectedWork number={numberOf("work")} videos={videos} />}
    <About number={numberOf("about")} />
    <Experience number={numberOf("experience")} />
    <SoftwareInAction number={numberOf("software")} />
    <Contact number={numberOf("contact")} />
  </main>
  <Footer />
  {videos.length > 0 && <Player />}
  <script>
    import "../scripts/motion";
  </script>
</Base>
